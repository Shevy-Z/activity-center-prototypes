+++ b/styles.css
@@ -0,0 +1,2 @@
+:root{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;color:#292c31;background:#f1f2f4;font-synthesis:none}*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden}button,input{font:inherit}button{color:inherit;cursor:pointer}button:focus-visible,input:focus-visible{outline:2px solid #4377b8;outline-offset:3px}button{border:1px solid #d6d9df;background:#fff;border-radius:5px}button:hover{background:#f4f5f7}button:active{background:#e9edf2}.toolbar{height:86px;position:absolute;inset:0 0 auto;z-index:20;display:flex;align-items:center;gap:22px;padding:14px 24px;border-bottom:1px solid #d8dbe0;background:#ffffffed;box-shadow:0 1px 4px #1d252908}.brand{display:flex;align-items:center;gap:12px;flex-shrink:0}.brand-mark{width:34px;height:34px;background:#30363d;color:white;border-radius:6px;display:grid;place-items:center;font-size:24px}.brand h1{font-size:17px;font-weight:650;margin:0 0 6px}.brand p{font-size:12px;color:#737b86;margin:0}#section-nav{display:flex;align-items:center;gap:4px;flex:1;min-width:0;overflow:auto;scrollbar-width:none}#section-nav::-webkit-scrollbar{display:none}#section-nav button{flex-shrink:0;border-color:transparent;background:transparent;padding:9px 11px;white-space:nowrap;font-size:13px;color:#616a76}#section-nav button.active{background:#eef1f5;color:#232b35;font-weight:650}#section-nav button:hover{background:#f3f4f6}.tool-button{padding:9px 12px;white-space:nowrap;font-size:13px}#viewport{position:absolute;inset:86px 0 0;overflow:hidden;cursor:grab;touch-action:none;background-image:radial-gradient(#cfd3da .85px,transparent .85px);background-size:20px 20px;outline:none}#viewport.dragging{cursor:grabbing}#world{position:absolute;left:0;top:0;transform-origin:0 0;will-change:transform;width:1px;height:1px;user-select:none}#sections,#nodes{position:absolute;inset:0;width:1px;height:1px}#sections{z-index:0}#connections{position:absolute;overflow:visible;left:0;top:0;z-index:1;pointer-events:none}#nodes{z-index:2}.board-section{position:absolute;border:1px solid #d7dbe0;background:#f9fafbbf;border-radius:4px;pointer-events:none}.section-caption{position:absolute;left:28px;right:28px;top:25px}.section-caption h2{font-size:27px;margin:0 0 10px;font-weight:650;letter-spacing:.4px}.section-caption p{font-size:16px;color:#747c87;margin:0;line-height:1.6}.state-node{position:absolute;margin:0;outline:1px solid #c3c8d0;background:white;box-shadow:0 3px 9px #1f27360b}.node-header{height:100px;padding:12px 14px;border-bottom:1px solid #e1e3e7;background:white;overflow:hidden}.node-header .node-code{color:#78808b;font-size:10px;letter-spacing:.4px;margin-bottom:4px;line-height:1}.node-header h3{margin:0 0 4px;font-size:17px;font-weight:650;line-height:1.3}.node-header p{font-size:12px;line-height:1.35;color:#717986;margin:0}.state-node img{display:block;width:100%;height:auto;pointer-events:none;-webkit-user-drag:none;background:#fff}.state-node.selected{outline:3px solid #65788f;box-shadow:0 0 0 9px #65788f1a}.state-node.decision{outline:0;box-shadow:none;background:transparent;display:flex;align-items:center;justify-content:center;text-align:center;padding:29px}.decision-shape{position:absolute;inset:0;width:100%;height:100%;overflow:visible;z-index:-1}.decision-shape polygon{fill:#fff;stroke:#626b76;stroke-width:1.5}.decision-content h3{font-size:18px;line-height:1.5;margin:0 0 7px;font-weight:600}.decision-content p{font-size:13px;line-height:1.5;color:#727985;margin:0}.state-node.note{background:#fffdf7;outline:1px solid #e1d8c5;box-shadow:none;padding:20px 24px}.note h3{font-size:19px;line-height:1.5;font-weight:600;margin:0 0 10px}.note p{font-size:15px;line-height:1.7;margin:0;color:#6d665d;white-space:pre-line}.state-node.note.emphasis h3,.state-node.note.emphasis p{color:#ad3f34}.image-missing{padding:40px 18px;color:#a44b3e;font-size:15px}.edge-path{fill:none;stroke:#5c6673;stroke-width:2.1;stroke-linejoin:round;stroke-linecap:round}.edge-path.detail{stroke:#7c8793;stroke-dasharray:7 6}.edge-path.return{stroke:#a85b4e;stroke-dasharray:9 6}.edge-label rect{fill:#f9fafb;stroke:#e3e5e9;stroke-width:.6;rx:3}.edge-label text{fill:#48505c;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:15px;text-anchor:middle;dominant-baseline:middle}.edge-label.return text{fill:#a35446}#page-list{position:absolute;right:18px;top:100px;bottom:88px;width:306px;border:1px solid #d7dce2;border-radius:8px;background:#fffffff5;box-shadow:0 10px 35px #20263320;z-index:25;overflow:hidden;display:flex;flex-direction:column}#page-list[hidden]{display:none}.list-head{height:55px;padding:12px 15px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #eee}.list-head strong{font-size:15px}.icon-button{border:0;font-size:25px;background:transparent;width:32px;height:32px;line-height:1}.search-label{display:flex;gap:7px;align-items:center;margin:13px 12px 10px;padding:8px 10px;border:1px solid #d7dce3;border-radius:4px;color:#8c949e}.search-label input{width:100%;border:0;outline:none;font-size:13px;background:transparent;color:#303944}.search-label input:focus-visible{outline:none}#search-results{overflow:auto;flex:1;padding:0 8px 12px}.result-group-label{color:#7b828d;font-size:11px;padding:14px 9px 5px}.result-item{display:block;text-align:left;width:100%;background:transparent;border:0;border-radius:4px;padding:10px 9px;font-size:13px;line-height:1.45}.result-item small{display:block;color:#9299a2;font-size:11px;margin-top:3px}.no-results{color:#7a828d;padding:20px 10px;font-size:13px}.canvas-tools{position:absolute;bottom:20px;left:50%;transform:translateX(-50%);z-index:22;display:flex;align-items:center;gap:15px;background:#fff;border:1px solid #d4d8df;border-radius:7px;box-shadow:0 3px 16px #31384113;padding:6px 7px 6px 15px;white-space:nowrap}.canvas-hint{font-size:12px;color:#79828d}.zoom-tools{display:flex;align-items:center;gap:2px}.zoom-tools button{height:34px;border:0;padding:0 10px;font-size:13px;border-radius:4px}#zoom-in,#zoom-out{font-size:18px;width:34px;padding:0}#zoom-reset{width:58px;font-variant-numeric:tabular-nums}.status{position:absolute;left:20px;bottom:26px;padding:7px 9px;border-radius:4px;font-size:11px;color:#78828e;background:#f9fafbe8;pointer-events:none;max-width:28vw;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#empty{position:absolute;inset:0;display:grid;place-items:center;color:#7f8791}#empty[hidden]{display:none}@media(max-width:1100px){.toolbar{gap:12px;padding:12px 16px}.brand-mark{display:none}.brand h1{font-size:15px}.brand p{font-size:11px}#section-nav button{padding:9px 8px;font-size:12px}.status{display:none}}@media(max-width:760px){.toolbar{height:116px;padding:12px 14px;flex-wrap:wrap;gap:8px}.brand{flex:1}.brand h1{font-size:14px}.brand p{font-size:11px}#section-nav{order:3;flex-basis:100%;height:33px}#section-nav button{padding:7px 9px}.tool-button{font-size:12px;padding:7px 9px}#viewport{top:116px}.canvas-tools{bottom:14px;padding:6px;gap:0}.canvas-hint{display:none}#page-list{top:128px;left:12px;right:12px;width:auto;bottom:76px}.section-caption h2{font-size:27px}}
+.state-node.dialog{background:#fff}.dialog-surface{height:160px;padding:25px 25px 22px;display:flex;flex-direction:column;align-items:center;justify-content:space-between;background:#fff}.dialog-message{margin:0;color:#555;font-size:15px;line-height:1.7;text-align:center}.dialog-actions{width:100%;display:flex;gap:22px;justify-content:center}.dialog-action{width:125px;height:37px;display:flex;align-items:center;justify-content:center;border-radius:3px;border:1px solid #b9b9b9;font-size:13px;pointer-events:none}.dialog-action.secondary{color:#ba3c32;background:#fff}.dialog-action.primary{color:#fff;background:#c63c32;border-color:#c63c32}
