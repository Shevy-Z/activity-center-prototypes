+.empty-state h3 { margin: 0 0 8px; font-size: 17px; }
+.empty-state p { margin: 0 0 20px; color: var(--muted); font-size: 13px; }
+.catalog-footer { display: flex; justify-content: space-between; gap: 20px; padding: 22px 0 28px; border-top: 1px solid var(--line); color: #978574; font-size: 11px; }
+@media (max-width: 950px) {
+  .catalog-intro { grid-template-columns: minmax(0, 1fr) 270px; gap: 24px; }
+  .scenario-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+@media (max-width: 640px) {
+  .catalog-shell { padding: 0 18px; }
+  .catalog-header { min-height: 70px; gap: 12px; }
+  .catalog-brand { gap: 9px; font-size: 12px; }
+  .brand-divider { margin: 0 4px; }
+  .mock-badge { font-size: 10px; padding-inline: 7px; }
+  .catalog-intro { grid-template-columns: 1fr; gap: 20px; padding-top: 28px; padding-bottom: 20px; }
+  .eyebrow { font-size: 11px; }
+  .intro-description { margin-block: 12px 18px; font-size: 13px; }
+  .intro-actions { display: grid; grid-template-columns: 1fr; gap: 8px; }
+  .preview-notes { padding: 14px 16px; }
+  .preview-notes ul { line-height: 1.65; }
+  .demo-notice { padding: 12px 14px; }
+  .notice-label { display: block; margin-bottom: 3px; }
+  .catalog-browser { padding-top: 26px; }
+  .browser-heading { display: grid; gap: 14px; margin-bottom: 14px; }
+  .search-form { width: 100%; }
+  .category-filters { gap: 6px; margin-bottom: 16px; }
+  .category-filter { padding-inline: 10px; }
+  .scenario-grid { grid-template-columns: minmax(0, 1fr); gap: 12px; }
+  .scenario-card { padding: 18px; }
+  .card-action { padding-top: 14px; }
+  .catalog-footer { flex-direction: column; gap: 4px; padding-block: 18px 24px; }
+}
+@media (prefers-reduced-motion: reduce) { .scenario-card { transition: none; } .scenario-card:hover { transform: none; } }
diff --git a/assets/css/global.css b/assets/css/global.css
new file mode 100644
index 0000000..392381d
--- /dev/null
+++ b/assets/css/global.css
@@ -0,0 +1,177 @@
+:root {
+  --brand: #d92f3e;
+  --brand-dark: #a9172b;
+  --brand-soft: #fff0f1;
+  --ink: #1f2329;
+  --ink-2: #4d535c;
+  --ink-3: #7d838c;
+  --line: #e9e5df;
+  --line-soft: #f0ede8;
+  --paper: #ffffff;
+  --canvas: #f5f3ef;
+  --warm: #fff8ec;
+  --success: #16845b;
+  --success-soft: #e9f7f1;
+  --warning: #b86a0e;
+  --warning-soft: #fff3dc;
+  --info: #2766c7;
+  --info-soft: #edf4ff;
+  --danger: #c53535;
+  --shadow: 0 12px 35px rgba(49, 34, 19, 0.08);
+  --font: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+html {
+  min-width: 320px;
+  background: #e7e3dc;
+}
+
+body {
+  margin: 0;
+  min-width: 320px;
+  min-height: 100vh;
+  color: var(--ink);
+  background:
+    radial-gradient(circle at 15% 10%, rgba(255, 255, 255, 0.9), transparent 28%),
+    linear-gradient(145deg, #ece9e4 0%, #dcd7cf 100%);
+  font-family: var(--font);
+  font-size: 14px;
+  line-height: 1.5;
+  -webkit-font-smoothing: antialiased;
+  -webkit-tap-highlight-color: transparent;
+}
+
+button,
+input,
+select {
+  font: inherit;
+}
+
+button {
+  color: inherit;
+}
+
+button:focus-visible,
+a:focus-visible {
+  outline: 3px solid rgba(217, 47, 62, 0.28);
+  outline-offset: 2px;
+}
+
+a {
+  color: inherit;
+}
+
+.prototype-app {
+  width: 100%;
+  min-height: 100vh;
+}
+
+.sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
+
+.icon-button {
+  width: 40px;
+  height: 40px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border: 0;
+  border-radius: 50%;
+  background: transparent;
+  cursor: pointer;
+}
+
+.primary-button,
+.secondary-button,
+.text-button {
+  border: 0;
+  cursor: pointer;
+}
+
+.primary-button {
+  min-height: 48px;
+  padding: 0 20px;
+  border-radius: 14px;
+  color: #fff;
+  background: linear-gradient(135deg, #e33a48, #c61f34);
+  box-shadow: 0 9px 20px rgba(198, 31, 52, 0.22);
+  font-weight: 650;
+}
+
+.primary-button:active {
+  transform: translateY(1px);
+  box-shadow: 0 5px 13px rgba(198, 31, 52, 0.18);
+}
+
+.secondary-button {
+  min-height: 46px;
+  padding: 0 18px;
+  border: 1px solid #d9d4cd;
+  border-radius: 14px;
+  color: var(--ink-2);
+  background: #fff;
+  font-weight: 600;
+}
+
+.text-button {
+  padding: 8px 10px;
+  color: var(--brand-dark);
+  background: transparent;
+  font-weight: 600;
+}
+
+.boot-screen {
+  width: min(430px, 100%);
+  min-height: 100vh;
+  margin: 0 auto;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  background: var(--canvas);
+  box-shadow: var(--shadow);
+}
+
+.boot-mark {
+  width: 68px;
+  height: 68px;
+  display: grid;
+  place-items: center;
+  border-radius: 22px;
+  color: #fff;
+  background: linear-gradient(145deg, #ef535f, #bd1830);
+  font-size: 28px;
+  font-weight: 700;
+}
+
+.boot-screen h1 {
+  margin: 18px 0 6px;
+  font-size: 22px;
+}
+
+.boot-screen p {
+  margin: 0;
+  color: var(--ink-3);
+}
+
+@media (max-width: 480px) {
+  html,
+  body {
+    background: var(--canvas);
+  }
+}
diff --git a/assets/css/original-layout.css b/assets/css/original-layout.css
new file mode 100644
index 0000000..09196c5
--- /dev/null
+++ b/assets/css/original-layout.css
@@ -0,0 +1,38 @@
+/* Local revision: keep the original policy material sequence and activity/coupon structure. */
+.policy-page .policy-content { padding: 12px 0 24px; }
+.policy-materials { display: flex; flex-direction: column; gap: 18px; }
+.policy-material { position: relative; display: block; flex: none; height: auto; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; overflow: hidden; }
+.policy-material img { display: block; width: 100%; height: auto; object-fit: contain; }
+.policy-material--hero, .policy-material--ribbon { width: calc(100% - 16px); height: auto; margin: 0 8px; }
+.policy-material--poster, .policy-material--rules { width: calc(100% - 48px); height: auto; margin: 12px 24px; }
+.policy-banner-label { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: grid; place-items: center; min-width: 132px; min-height: 42px; padding: 8px 24px; border: 1px solid #bfbfbf; border-radius: 4px; background: #fff; color: #e60022; font-size: 18px; font-weight: 600; white-space: nowrap; }
+.policy-material:focus-visible { outline: 3px solid #e60022; outline-offset: 2px; }
+.result-page { background: #eee; }
+.legacy-result-content { padding: 12px 0 max(20px, env(safe-area-inset-bottom)); }
+.legacy-activity-stack { display: grid; gap: 10px; }
+.legacy-activity { min-width: 0; border: 1px solid #9b9b9b; background: #fff; }
+.legacy-activity h2 { margin: 0; padding: 10px 12px 9px; color: #333; font-size: 15px; font-weight: 400; line-height: 1.4; text-align: center; overflow-wrap: anywhere; }
+.legacy-coupon-list { display: grid; gap: 9px; padding: 0 12px 10px; }
+.legacy-coupon { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-width: 0; min-height: 80px; padding: 10px 12px; background: #ccc url('../images/coupon-original.svg') center / 100% 100% no-repeat; }
+.legacy-coupon-copy { display: flex; flex-direction: column; justify-content: center; gap: 1px; min-width: 0; color: #e60022; }
+.legacy-coupon-copy strong { font-size: 24px; font-weight: 700; line-height: 1.1; }
+.legacy-coupon-copy span { font-size: 12px; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
+.legacy-coupon-control { display: flex; flex-direction: column; align-items: center; flex: 0 0 118px; gap: 3px; }
+.legacy-coupon-button { width: 100%; min-height: 38px; padding: 6px; border: 1px solid #999; border-radius: 5px; background: #fff; color: #e60022; font-size: 13px; line-height: 1.4; cursor: pointer; }
+.legacy-coupon-button:disabled { background: #d7d7d7; color: #555; cursor: default; }
+.legacy-coupon-state { padding: 1px 4px; background: #fff; color: #575757; font-size: 10px; line-height: 1.2; }
+.legacy-expand { display: block; width: 100%; min-height: 36px; margin: 0; border: 0; border-top: 1px solid #aaa; background: #fff; color: #333; font-size: 14px; cursor: pointer; }
+.legacy-expand:focus-visible, .legacy-coupon-button:focus-visible { outline: 2px solid #e60022; outline-offset: -3px; }
+.legacy-draw-note { margin: 0; padding: 0 12px 8px; color: #777; font-size: 12px; text-align: center; }
+.legacy-unlock-note { margin: 0; padding: 0 12px 10px; color: #a22b22; font-size: 12px; line-height: 1.65; }
+.legacy-countdown { margin: 0; padding: 2px 12px 10px; color: #333; font-size: 13px; line-height: 1.5; }
+.legacy-result-notice { margin: 0 0 10px; padding: 12px; color: #555; background: #fff; font-size: 14px; }
+.legacy-level-note { margin: 0 0 12px; padding: 12px; border-block: 1px solid #dfd5c5; background: #fffaf2; color: #6b4828; font-size: 13px; line-height: 1.6; }
+.legacy-level-note strong { display: block; font-weight: 600; }
+.legacy-level-note p { margin: 4px 0 0; font-size: 12px; }
+@media (max-width: 360px) {
+  .legacy-coupon-list { padding-inline: 8px; }
+  .legacy-coupon { padding-inline: 10px; }
+  .legacy-coupon-control { flex-basis: 108px; }
+  .legacy-coupon-copy strong { font-size: 21px; }
+}
